@media(max-width:600px){.pipe{grid-template-columns:1fr}.pipe .node::after{display:none}.pipe .node{border-right:none;border-bottom:1px solid var(--line)}}

.moves{display:grid;grid-template-columns:1fr;gap:10px;margin-top:34px}
.move{
  background:var(--ink);border:1px solid var(--line);padding:16px 18px;
