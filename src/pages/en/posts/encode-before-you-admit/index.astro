.vs-verdict b{color:var(--green-soft);font-weight:500}

/* ============ 02 PIPELINE ============ */
.pipe{display:grid;grid-template-columns:repeat(4,1fr);gap:0;border:1px solid var(--line);background:var(--ink)}
.pipe .node{padding:22px 20px 18px;border-right:1px solid var(--line);position:relative;transition:background .3s}
.pipe .node:last-child{border-right:none}
.pipe .node:hover{background:var(--panel)}
.pipe .node::after{
  content:"▸";position:absolute;right:-9px;top:46px;
  color:var(--green);font-size:15px;z-index:2;background:var(--ink);padding:2px 0;
}
.pipe .node:last-child::after{display:none}
.pipe .tag{font-family:var(--mono);font-size:10px;letter-spacing:.2em;padding:3px 8px;display:inline-block;margin-bottom:16px}
.tag.cpu{color:var(--paper-faint);border:1px solid var(--line-2)}
.tag.gpu{color:var(--blue);border:1px solid rgba(31,111,214,.45)}
.tag.new{color:var(--green);border:1px solid rgba(12,161,18,.5)}
.pipe h3{font-family:var(--display);font-weight:400;font-size:21px;margin-bottom:10px}
.pipe p{font-size:12.5px;color:var(--paper-dim);line-height:1.7}
.pipe .mono-note{font-family:var(--mono);font-size:10.5px;color:var(--green);margin-top:12px;display:block}
.pipe .opts{margin-top:12px;padding-top:10px;border-top:1px dashed var(--line)}
.pipe .opts span{
  display:inline-block;font-family:var(--mono);font-size:9.5px;letter-spacing:.06em;
  color:var(--green-soft);background:rgba(12,161,18,.07);border:1px solid rgba(12,161,18,.3);
  padding:2px 7px;border-radius:3px;margin:0 5px 6px 0;
}
