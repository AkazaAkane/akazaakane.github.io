.note{font-size:12px;color:var(--paper-faint);font-family:var(--mono)}

/* ============ 01 BEFORE/AFTER ============ */
#problem{background:var(--ink-3);border-top:1px solid var(--line);border-bottom:1px solid var(--line)}
.vs-grid{display:grid;grid-template-columns:1fr 1fr;gap:0;border:1px solid var(--line);background:var(--ink)}
