<style>
:root{
  --ink:#FFFFFF;
  --ink-2:#FAFBFB;
  --ink-3:#F5F6F8;
  --panel:#ECEEF1;
  --line:#E3E6EA;
  --line-2:#D2D7DD;
  --paper:#181818;
  --paper-soft:#2E3338;
  --paper-dim:#5C6670;
  --paper-faint:#8A9099;
  --green:#0CA112;
  --green-soft:#0A7A02;
  --blue:#1F6FD6;
  --blue-soft:#0E63B8;
  --blue-deep:#007EA4;
  --red:#D93540;
  --display:'Marcellus','Noto Serif SC',serif;
  --body:'Plus Jakarta Sans','Noto Sans SC',sans-serif;
  --mono:'IBM Plex Mono',monospace;
}
*{margin:0;padding:0;box-sizing:border-box}
::selection{background:var(--green);color:#fff}
html{scroll-behavior:smooth}
body{
  background:var(--ink);
  color:var(--paper-soft);
  font-family:var(--body);
  font-weight:300;
  line-height:1.8;
  overflow-x:hidden;
}
body::before{
  content:"";position:fixed;inset:0;pointer-events:none;z-index:998;
  background-image:
    linear-gradient(to right,rgba(40,70,50,.035) 1px,transparent 1px),
    linear-gradient(to bottom,rgba(40,70,50,.035) 1px,transparent 1px);
  background-size:88px 88px;
}
body::after{
  content:"";position:fixed;inset:0;pointer-events:none;z-index:999;opacity:.02;
  background-image:url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='2'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)'/%3E%3C/svg%3E");
}
a{color:var(--blue);text-decoration:none;border-bottom:1px dotted var(--blue-deep)}
a:hover{color:var(--green-soft);border-color:var(--green)}
.mono{font-family:var(--mono)}
h1,h2,h3{color:var(--paper)}

/* ============ NAV ============ */
nav{
  position:fixed;top:0;left:0;right:0;z-index:100;
  display:flex;align-items:center;justify-content:space-between;
  padding:14px 32px;
  background:linear-gradient(to bottom,rgba(255,255,255,.95),rgba(255,255,255,.82));
  backdrop-filter:blur(12px);
  border-bottom:1px solid var(--line);
}
nav .brand{font-family:var(--mono);font-size:12px;letter-spacing:.18em;color:var(--paper-faint);border-bottom:none}
nav .brand b{color:var(--green);font-weight:600}
nav .links{display:flex;gap:20px;font-size:13px}
nav .links a{color:var(--paper-faint);border:none;letter-spacing:.04em;transition:color .2s}
nav .links a:hover{color:var(--green-soft)}
nav .links .num{font-family:var(--mono);font-size:10px;color:var(--blue);margin-right:4px}
@media(max-width:1000px){nav .links{display:flex}.links a:not(:last-child){display:none}}

/* ============ HERO ============ */
.hero{
  min-height:92vh;position:relative;
  display:flex;flex-direction:column;justify-content:center;
  padding:108px 6vw 50px;
  background:
    radial-gradient(ellipse 80% 50% at 72% 18%,rgba(31,111,214,.06),transparent 60%),
    radial-gradient(ellipse 60% 40% at 18% 82%,rgba(12,161,18,.06),transparent 60%);
}
.hero .kicker{
  font-family:var(--mono);font-size:12px;letter-spacing:.35em;
  color:var(--green);text-transform:uppercase;margin-bottom:28px;
  display:flex;align-items:center;gap:14px;
  animation:fadeUp .8s .1s both;
}
.hero .kicker::before{content:"";width:48px;height:1px;background:var(--green)}
.hero h1{
  font-family:var(--display);font-weight:400;
  font-size:clamp(40px,7.4vw,96px);
  line-height:1.1;letter-spacing:.01em;
  animation:fadeUp .8s .25s both;
}
.hero h1 .l2{display:block;color:var(--green-soft);font-size:.52em;margin-top:.18em}
.hero .sub{
  margin-top:22px;max-width:700px;font-size:16px;color:var(--paper-dim);
  animation:fadeUp .8s .4s both;
}
.hero .sub b{color:var(--paper);font-weight:500}
.hero-stats{
  display:flex;flex-wrap:wrap;gap:0;margin-top:40px;
  border-top:1px solid var(--line);
  animation:fadeUp .8s .55s both;
}
.hero-stats .stat{
  padding:20px 28px 4px 0;margin-right:28px;
  border-right:1px dashed var(--line);
}
.hero-stats .stat:last-child{border-right:none}
.hero-stats .v{font-family:var(--mono);font-size:clamp(28px,4vw,44px);font-weight:600;color:var(--paper)}
.hero-stats .v em{font-style:normal;font-size:.42em;color:var(--paper-faint);margin-left:4px}
.hero-stats .k{font-size:11.5px;color:var(--paper-faint);letter-spacing:.12em;margin-top:2px}
.hero-stats .stat:nth-child(1) .v{color:var(--green)}
.hero-stats .stat:nth-child(2) .v{color:var(--blue)}
@media(max-width:1180px){.hero-stats{padding-bottom:110px}}
.wave-strip{
  position:absolute;left:0;right:0;bottom:0;height:120px;overflow:hidden;
  opacity:.85;pointer-events:none;
  -webkit-mask-image:linear-gradient(to right,transparent,#000 12%,#000 88%,transparent);
  mask-image:linear-gradient(to right,transparent,#000 12%,#000 88%,transparent);
}
.wave-strip .bars{position:absolute;inset:0;display:flex;align-items:center;gap:5px;padding:0 4vw}
.wave-strip .bars i{
  flex:1;background:linear-gradient(to top,#2a6fc4,#7db4ef);
  min-width:2px;border-radius:1px;opacity:.5;
  animation:pulse 1.6s ease-in-out infinite;
}
.wave-strip .bars i:nth-child(3n){background:linear-gradient(to top,#0a7a02,#2ec934)}
@keyframes pulse{0%,100%{transform:scaleY(.35)}50%{transform:scaleY(1)}}
@keyframes fadeUp{from{opacity:0;transform:translateY(28px)}to{opacity:1;transform:none}}

/* ============ SHARED ============ */
section{padding:64px 6vw;position:relative}
.sec-head{display:flex;align-items:baseline;gap:22px;margin-bottom:10px}
.sec-head .no{
  font-family:var(--mono);font-size:13px;color:var(--green);
  border:1px solid rgba(12,161,18,.5);padding:4px 10px;letter-spacing:.1em;
}
.sec-head h2{
  font-family:var(--display);font-weight:400;
  font-size:clamp(28px,4vw,46px);letter-spacing:.01em;
}
.sec-lede{max-width:780px;color:var(--paper-dim);font-size:15px;margin-bottom:30px}
.sec-lede b{color:var(--green-soft);font-weight:500}
.reveal{opacity:0;transform:translateY(36px);transition:opacity .7s ease,transform .7s ease}
.reveal.in{opacity:1;transform:none}
code{
  font-family:var(--mono);font-size:.86em;color:var(--blue-soft);
  background:var(--ink-3);border:1px solid var(--line);padding:1px 7px;border-radius:3px;
  white-space:nowrap;
}
.note{font-size:12px;color:var(--paper-faint);font-family:var(--mono)}

/* ============ 01 BEFORE/AFTER ============ */
#problem{background:var(--ink-3);border-top:1px solid var(--line);border-bottom:1px solid var(--line)}
.vs-grid{display:grid;grid-template-columns:1fr 1fr;gap:0;border:1px solid var(--line);background:var(--ink)}
@media(max-width:880px){.vs-grid{grid-template-columns:1fr}}
.vs-col{padding:26px 26px 22px}
.vs-col.before{border-right:1px solid var(--line)}
@media(max-width:880px){.vs-col.before{border-right:none;border-bottom:1px solid var(--line)}}
.vs-col .vtag{font-family:var(--mono);font-size:10px;letter-spacing:.24em;padding:4px 10px;display:inline-block;margin-bottom:20px}
.vs-col.before .vtag{color:var(--red);border:1px solid rgba(217,53,64,.45)}
.vs-col.after .vtag{color:var(--green);border:1px solid rgba(12,161,18,.5)}
.vs-col h3{font-family:var(--display);font-size:26px;font-weight:400;margin-bottom:6px}
.vs-col .vsub{font-family:var(--mono);font-size:11px;color:var(--paper-faint);letter-spacing:.1em;margin-bottom:18px}
.vs-col ul{list-style:none}
.vs-col li{
  padding:8px 0 8px 24px;border-top:1px dashed var(--line);
  font-size:13.5px;color:var(--paper-dim);position:relative;
}
.vs-col li::before{content:"›";position:absolute;left:4px;font-family:var(--mono)}
.vs-col.before li::before{color:var(--red)}
.vs-col.after li::before{color:var(--green)}
.vs-col li b{color:var(--paper);font-weight:500}
.vflow{
  position:relative;height:54px;margin:4px 0 14px;
  border:1px dashed var(--line-2);border-radius:4px;background:var(--ink-2);
  display:flex;align-items:center;padding:0 16px;gap:10px;overflow:hidden;
}
.vf-box{
  font-family:var(--mono);font-size:9.5px;letter-spacing:.08em;color:var(--paper-soft);
  border:1px solid var(--line-2);background:var(--panel);padding:6px 9px;border-radius:3px;
  white-space:nowrap;z-index:2;
}
.vflow.before .vf-box{border-color:rgba(217,53,64,.4)}
.vflow.after .vf-box{border-color:rgba(12,161,18,.45)}
.vf-box.hl{border-color:var(--green);color:var(--green-soft);background:rgba(12,161,18,.06)}
.vf-arrow{font-family:var(--mono);font-size:10px;color:var(--paper-faint);z-index:2;animation:arrowPulse 1.2s ease-in-out infinite}
@keyframes arrowPulse{0%,100%{opacity:.35}50%{opacity:1}}
.vs-verdict{
  margin-top:16px;max-width:1020px;padding:14px 22px;
  background:linear-gradient(to right,rgba(12,161,18,.06),transparent);
  border-left:3px solid var(--green);font-size:14px;color:var(--paper-dim);
}
.vs-verdict b{color:var(--green-soft);font-weight:500}

/* ============ 02 PIPELINE ============ */
.pipe{display:grid;grid-template-columns:repeat(4,1fr);gap:0;border:1px solid var(--line);background:var(--ink)}
.pipe .node{padding:22px 20px 18px;border-right:1px solid var(--line);position:relative;transition:background .3s}
.pipe .node:last-child{border-right:none}
.pipe .node:hover{background:var(--panel)}
.pipe .node::after{
  content:"▸";position:absolute;right:-9px;top:46px;
  color:var(--green);font-size:15px;z-index:2;background:var(--ink);padding:2px 0;
}
.pipe .node:last-child::after{display:none}
.pipe .tag{font-family:var(--mono);font-size:10px;letter-spacing:.2em;padding:3px 8px;display:inline-block;margin-bottom:16px}
.tag.cpu{color:var(--paper-faint);border:1px solid var(--line-2)}
.tag.gpu{color:var(--blue);border:1px solid rgba(31,111,214,.45)}
.tag.new{color:var(--green);border:1px solid rgba(12,161,18,.5)}
.pipe h3{font-family:var(--display);font-weight:400;font-size:21px;margin-bottom:10px}
.pipe p{font-size:12.5px;color:var(--paper-dim);line-height:1.7}
.pipe .mono-note{font-family:var(--mono);font-size:10.5px;color:var(--green);margin-top:12px;display:block}
.pipe .opts{margin-top:12px;padding-top:10px;border-top:1px dashed var(--line)}
.pipe .opts span{
  display:inline-block;font-family:var(--mono);font-size:9.5px;letter-spacing:.06em;
  color:var(--green-soft);background:rgba(12,161,18,.07);border:1px solid rgba(12,161,18,.3);
  padding:2px 7px;border-radius:3px;margin:0 5px 6px 0;
}
@media(max-width:1060px){.pipe{grid-template-columns:1fr 1fr}.pipe .node:nth-child(2)::after{display:none}}
@media(max-width:600px){.pipe{grid-template-columns:1fr}.pipe .node::after{display:none}.pipe .node{border-right:none;border-bottom:1px solid var(--line)}}

.moves{display:grid;grid-template-columns:1fr;gap:10px;margin-top:34px}
.move{
  background:var(--ink);border:1px solid var(--line);padding:16px 18px;
  border-left:3px solid var(--blue-deep);transition:border-color .3s;
}
.move:hover{border-left-color:var(--green)}
.move .m-name{font-weight:500;font-size:15px;color:var(--paper);margin-bottom:8px;display:flex;align-items:center;gap:10px;flex-wrap:wrap}
.move .m-name .mk{font-family:var(--mono);font-size:10px;color:var(--green);border:1px solid rgba(12,161,18,.5);padding:2px 7px;letter-spacing:.1em}
.move p{font-size:13px;color:var(--paper-dim);line-height:1.7;margin-bottom:5px;max-width:940px}
.move p:last-of-type{margin-bottom:0}
.move p b{color:var(--paper);font-weight:500}
.move.guard{border-left-color:var(--red)}
.move.guard .m-name .mk{color:var(--red);border-color:rgba(217,53,64,.5)}
.spec{
  margin-top:14px;border:1px dashed var(--line-2);padding:12px 16px;
  font-family:var(--mono);font-size:12px;color:var(--paper-dim);line-height:2;
}
.spec b{color:var(--blue-soft);font-weight:500}
.spec .sl{color:var(--paper-faint)}
.callout{
  margin-top:12px;padding:14px 20px;
  background:linear-gradient(to right,rgba(12,161,18,.06),transparent);
  border-left:3px solid var(--green);font-size:13.5px;color:var(--paper-dim);
}
.callout b{color:var(--green-soft);font-weight:500}
.callout.danger{background:linear-gradient(to right,rgba(217,53,64,.06),transparent);border-left-color:var(--red)}
.callout.danger b{color:var(--red)}

/* ============ 03–05 BENCH ============ */
#control{background:var(--ink-3);border-top:1px solid var(--line);border-bottom:1px solid var(--line)}
.bench-wrap{display:grid;grid-template-columns:minmax(0,1.05fr) minmax(0,.95fr);gap:40px;align-items:start}
@media(max-width:980px){.bench-wrap{grid-template-columns:1fr}}
table{width:100%;border-collapse:collapse;font-family:var(--mono);font-size:13px}
thead th{
  text-align:right;font-weight:500;color:var(--blue);font-size:11px;letter-spacing:.1em;
  padding:12px 14px;border-bottom:1px solid var(--blue-deep);white-space:nowrap;
}
thead th:first-child{text-align:left}
td{text-align:right;padding:12px 14px;border-bottom:1px solid var(--line);color:var(--paper-dim)}
td:first-child{text-align:left;color:var(--paper);font-weight:500}
tr.hi td{background:rgba(12,161,18,.05)}
td .pos{color:var(--green-soft);font-weight:600}
td .neu{color:var(--paper-faint)}
.tbl-note{font-size:12px;color:var(--paper-faint);margin-top:14px;font-family:var(--mono)}
.bars-title{font-family:var(--mono);font-size:11px;letter-spacing:.22em;color:var(--paper-faint);margin-bottom:22px}
.bbar{margin-bottom:18px}
.bbar .lab{display:flex;justify-content:space-between;font-family:var(--mono);font-size:11px;color:var(--paper-dim);margin-bottom:7px}
.bbar .lab b{color:var(--blue);font-weight:600}
.bbar .track{height:22px;background:var(--panel);border:1px solid var(--line);position:relative;overflow:hidden}
.bbar .fill{
  height:100%;width:0;
  background:linear-gradient(to right,#2a6fc4,#5b9be8);
  transition:width 1.2s cubic-bezier(.22,1,.36,1);position:relative;
}
.bbar .fill::after{content:"";position:absolute;right:0;top:0;bottom:0;width:2px;background:#fff;opacity:.7}
.bbar.hot .fill{background:linear-gradient(to right,#0a7a02,#14b81b)}
.bbar.hot .lab b{color:var(--green)}
.bbar.dim .fill{background:linear-gradient(to right,#9aa4ae,#c3ccd4)}
.bbar.dim .lab b{color:var(--paper-dim)}
.rtf-pill{
  display:inline-flex;align-items:baseline;gap:10px;margin-top:26px;
  border:1px dashed var(--line-2);padding:16px 24px;font-family:var(--mono);
}
.rtf-pill .big{font-size:30px;font-weight:600;color:var(--green);white-space:nowrap}
.rtf-pill span{font-size:12px;color:var(--paper-faint)}

/* ============ 06 CORRECTNESS ============ */
.q-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:18px}
@media(max-width:900px){.q-grid{grid-template-columns:1fr 1fr}}
.q-card{border:1px solid var(--line);padding:20px 22px;background:var(--ink-3)}
.q-card .qv{font-family:var(--mono);font-size:26px;font-weight:600;color:var(--green)}
.q-card .qv.blue{color:var(--blue)}
.q-card .qk{font-size:12px;color:var(--paper-faint);margin-top:4px;line-height:1.5}
blockquote{
  margin:54px auto 0;max-width:840px;text-align:center;
  font-family:var(--display);font-weight:400;font-size:clamp(20px,2.8vw,29px);
  line-height:1.65;color:var(--paper);padding:0 20px;
}
blockquote .hl{color:var(--green-soft)}
blockquote footer{font-family:var(--mono);font-size:12px;color:var(--paper-faint);margin-top:22px;letter-spacing:.15em}

footer.site{
  padding:38px 6vw 32px;border-top:1px solid var(--line);
  display:flex;justify-content:space-between;flex-wrap:wrap;gap:24px;
  font-size:13px;color:var(--paper-faint);
}
footer.site .src{max-width:640px}
footer.site .src b{display:block;font-family:var(--mono);font-size:11px;letter-spacing:.22em;color:var(--paper-dim);margin-bottom:12px}
footer.site .sig{font-family:var(--mono);font-size:11px;letter-spacing:.15em;text-align:right}
</style>
</head>
