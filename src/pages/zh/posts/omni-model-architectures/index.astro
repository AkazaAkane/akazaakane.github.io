  {x:1.75, y:0.62, name:'Higgs / ZONOS2'},
  {x:2.45, y:0.60, name:'Voxtral'},
  {x:2.30, y:0.85, name:'Qwen3-TTS'},
  {x:2.70, y:0.92, name:'Qwen3-Omni'},
  {x:2.55, y:0.70, name:'Fish S2-Pro'},
  {x:2.85, y:0.45, name:'dots.tts'},
  {x:2.95, y:0.62, name:'Ming-omni-TTS'},
  {x:2.95, y:0.85, name:'Ming-flash-omni'},
];
const MAP_XLAB = ['Talker representation · discrete → continuous','Talker 表示 · 离散 → 连续'];
const MAP_YLAB = ['Inter-layer serialization ↑','层间串行化程度 ↑'];

const CMP_HEAD = ['Model','Thinker / Backbone','Talker strategy','Codec / VAE','Rate','Vocoder','Cold-start'];
const CMP_ROWS = [
  ['Qwen3-Omni-30B-A3B','MoE 30B-A3B · 48L · hidden 2048','Talker MoE 3B-A0.3B · 20L + MTP 80M · 5L (fixed steps)','16 codebooks · vocab 3072','12.5 Hz','Code2Wav ≈200M causal ConvNet · 24 kHz','234 ms TTFB'],
  ['Ming-flash-omni-2.0','BailingMoE v2 · 32L · 256 experts top-8+1','dense Talker + CFM/DiT 28L (10-step ODE)','AudioVAE latents','—','AudioVAE decoder','—'],
  ['Fish Audio S2-Pro','Slow AR 4B · 36L','nested Fast AR 400M · 4L ×9 steps (static KV)','RVQ 10 codebooks','~21 Hz','EVA-GAN','—'],
  ['Higgs Audio v3','Qwen3 ≈4B','delay pattern · fused multi-cb head','8 codebooks · vocab 1026','25 fps','codec decoder','—'],
  ['ZONOS2','MoE 8B / 0.9B active','delay pattern','DAC 9 codebooks','—','DAC decoder','—'],
  ['MOSS-TTS (delay)','8B','delay pattern · 33 parallel heads','32 codebooks','12.5 Hz','codec decoder','—'],
  ['MOSS-TTS-Local','8B (same backbone)','intra-frame Local Transformer ×32 steps','32 codebooks','12.5 Hz','codec decoder','—'],
  ['Qwen3-TTS','AR backbone (Qwen3 family)','cb0 AR + MTP ×15 (fixed steps)','16 codebooks','12.5 Hz','Code2Wav family','—'],
  ['Voxtral TTS','AR decoder 3.4B','1 semantic token/frame + flow-matching 390M · 8 NFE → 36 FSQ','VQ 8192 + FSQ','—','codec decoder 300M','—'],
  ['dots.tts','Qwen2.5-1.5B','AR flow head (DiTAR-style) · 1 step/frame','AudioVAE latents','—','AudioVAE + BigVGAN 48 kHz','—'],
  ['Ming-omni-TTS','dense Talker','CFM / DiT · multi-step ODE','AudioVAE latents','—','AudioVAE decoder','—'],
  ['Qwen3-ASR','Qwen3 LLM','— (ASR)','AuT encoder 12.5 Hz continuous','12.5 Hz','—','—'],
  ['Fun-ASR-Nano-2512','Qwen3-0.6B · 28L + CTC 5L sidecar','— (ASR)','SenseVoice SANM encoder 512-d','—','—','—'],
];

/* ============================= SVG helpers ============================= */
const CW=252, CG=24, PADX=16, ITEM_GAP=9, SEG_GAP=16, BAND_GAP=22, BAND_HEAD=26, LANE_HEAD=66;
const INK='#1c2330', MUT='#5b6472', ARR='#98a2b3';

function esc(s){return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');}
function estW(s,px){let w=0;for(const ch of String(s)){w+=(ch.codePointAt(0)>255?px*0.98:px*0.52);}return w;}
function wrapText(s,px,w){
  if(estW(s,px)<=w) return [s];
  const isZh=/[\u4e00-\u9fff]/.test(s);
  const toks=isZh?[...s]:String(s).split(' ');
  const lines=[];let cur='';
  for(const t of toks){
    const trial=isZh?cur+t:(cur?cur+' '+t:t);
    if(estW(trial,px)<=w||!cur) cur=trial;
    else{lines.push(cur);cur=t;}
  }
  if(cur)lines.push(cur);
  return lines.slice(0,3);
}
function text(x,y,s,o={}){
  const {px=12,wgt=400,c=INK,anchor='start',ls=0}=o;
  return `<text x="${x}" y="${y}" font-size="${px}" font-weight="${wgt}" fill="${c}" text-anchor="${anchor}"${ls?` letter-spacing="${ls}"`:''}>${esc(s)}</text>`;
}

/* ---------- item layout ---------- */
function boxLayout(it,w){
  const pad=9, iw=w-pad*2;
  const L={tag:it.tag?T(it.tag):null, title:wrapText(T(it.l[0]),12.5,iw).slice(0,2), subs:[]};
  let h=pad+(L.tag?13:0)+L.title.length*16;
  for(let i=1;i<it.l.length;i++){
    const ls=wrapText(T(it.l[i]),11,iw).slice(0,2);
    L.subs.push(ls); h+=ls.length*14+1;
  }
  h+=pad-3;
  return {h,L};
}
function itemH(it,w){
  switch(it.b){
    case 'pill': return 24;
    case 'badge': return 20;
    case 'box': case 'side': return boxLayout(it,w).h;
    case 'split': return Math.max(...it.items.map(b=>boxLayout(b,(w-28)/2).h));
    case 'grid': {const lv=Math.min(it.grid.levels,6); return lv*11+8;}
  }
  return 0;
}
function cellH(cell,w){
  if(!cell||!cell.flow||!cell.flow.length) return 0;
  return cell.flow.reduce((a,it)=>a+itemH(it,w),0)+(cell.flow.length-1)*ITEM_GAP;
}

/* ---------- item drawing ---------- */
function drawBox(it,x,y,w){
  const {h,L}=boxLayout(it,w);
  const common=it.style==='common', side=it.b==='side';
  const col=it.c||STAGES.talker.c;
  const fill=side?'#fafbfc':(common?'#f3f5f8':'#fff');
  const stroke=side?'#b9c1cc':(common?'#d3d9e1':col);
  const sw=side||common?1.5:2;
  let s=`<rect x="${x}" y="${y}" width="${w}" height="${h}" rx="8" fill="${fill}" stroke="${stroke}" stroke-width="${sw}"${side?' stroke-dasharray="5 4"':''}/>`;
  let ty=y+9+9;
  if(L.tag){s+=text(x+9,ty-2,L.tag,{px:9,wgt:700,c:side||common?'#8a93a1':col,ls:'.07em'});ty+=13;}
  for(const ln of L.title){s+=text(x+9,ty,ln,{px:12.5,wgt:side||common?600:700,c:side||common?'#39404d':INK});ty+=16;}
  for(const sub of L.subs)for(const ln of sub){s+=text(x+9,ty-2,ln,{px:11,c:MUT});ty+=14;}
  return s;
}
function drawItem(it,x,y,w){
  switch(it.b){
    case 'pill':{
      const t=T(it.l), pw=Math.min(w,estW(t,11)+26), px=x+(w-pw)/2;
      return `<rect x="${px}" y="${y}" width="${pw}" height="24" rx="12" fill="#eef1f5" stroke="#c9d0da" stroke-width="1"/>`+text(x+w/2,y+16,t,{px:11,c:'#4b5563',anchor:'middle'});
    }
    case 'badge':{
      const t=T(it.l), bw=estW(t,10.5)+18, bx=x+(w-bw)/2;
      return `<rect x="${bx}" y="${y}" width="${bw}" height="20" rx="5" fill="${it.c||'#6b7280'}"/>`+text(x+w/2,y+14,t,{px:10.5,wgt:700,c:'#fff',anchor:'middle'});
    }
    case 'box': case 'side': return drawBox(it,x,y,w);
    case 'split':{
      const bw=(w-28)/2, h=itemH(it,w);
      let s='';
      it.items.forEach((b,i)=>{
        const bh=boxLayout(b,bw).h, by=y+(h-bh)/2;
        s+=drawBox(b,x+i*(bw+28),by,bw);
      });
      // "or" gutter
      s+=text(x+w/2,y+h/2+4,T(['or','或']),{px:10.5,wgt:700,c:MUT,anchor:'middle'});
      return s;
    }
    case 'grid':{
      const lv=Math.min(it.grid.levels,6), cols=Math.min(it.grid.cols,6), sq=8, g=3;
      const gw=cols*(sq+g)-g, ell=it.grid.ellipsis;
      const x0=x+(w-gw-(ell?16:0))/2, col=it.c||STAGES.talker.c;
      let s='';
      for(let r=0;r<lv;r++)for(let c=0;c<cols;c++){
        const on=c>=r;
        s+=`<rect x="${x0+c*(sq+g)}" y="${y+4+r*(sq+g)}" width="${sq}" height="${sq}" rx="1.5" fill="${on?col:'#e2e7ee'}"${on?' opacity="0.88"':''}/>`;
      }
      if(ell) s+=text(x0+gw+6,y+4+lv*(sq+g)/2+3,'…',{px:12,wgt:700,c:MUT});
      return s;
    }
  }
  return '';
}

/* ---------- figure renderer ---------- */
function renderFigure(cfg,mount){
  const n=cfg.lanes.length, W=PADX*2+n*CW+(n-1)*CG;
  const laneX=i=>PADX+i*(CW+CG), laneCx=i=>laneX(i)+CW/2;
  const areaCx=(laneCx(0)+laneCx(n-1))/2;
  const SW=Math.min(360,n*CW+(n-1)*CG-60);

  /* layout pass */
  let y=LANE_HEAD;
  const bandLay=[];
  for(const band of cfg.bands){
    const bl={band,yHead:y,segs:[]};
    y+=BAND_HEAD;
    for(const seg of band.segs){
      const h=seg.type==='shared'?cellH(cfg.shared[seg.key],SW)
        :Math.max(0,...cfg.lanes.map((_,i)=>cellH((cfg.cells[i]||{})[seg.key],CW)));
      bl.segs.push({seg,y,h});
      y+=h+SEG_GAP;
    }
    bl.yBot=y-SEG_GAP;
    y+=BAND_GAP;
    bandLay.push(bl);
  }
  const H=y+4;

  let s=`<svg width="${W}" height="${H}" viewBox="0 0 ${W} ${H}" xmlns="http://www.w3.org/2000/svg" role="img">`;
  s+=`<defs><marker id="ah" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="6.5" markerHeight="6.5" orient="auto"><path d="M0 0L10 5L0 10z" fill="${ARR}"/></marker></defs>`;

  /* band tints + thin headers */
  for(const bl of bandLay){
    const st=STAGES[bl.band.stage];
    s+=`<rect x="4" y="${bl.yHead-4}" width="${W-8}" height="${bl.yBot-bl.yHead+12}" rx="10" fill="${st.c}" opacity="0.045"/>`;
    s+=`<circle cx="16" cy="${bl.yHead+9}" r="4" fill="${st.c}"/>`;
    const nm=bl.band.title?T(bl.band.title[0]):T(st.name), ds=T(st.desc);
    s+=text(26,bl.yHead+13,nm,{px:12,wgt:800,c:st.c,ls:'.04em'});
    if(26+estW(nm,12)+estW(ds,10.5)+60<W) s+=text(W-14,bl.yHead+12,ds,{px:10.5,c:MUT,anchor:'end'});
    s+=`<line x1="10" y1="${bl.yHead+BAND_HEAD-7}" x2="${W-10}" y2="${bl.yHead+BAND_HEAD-7}" stroke="#e4e8ef" stroke-width="1"/>`;
  }

  /* lane headers */
  cfg.lanes.forEach((ln,i)=>{
    const cx=laneCx(i);
    s+=text(cx,15,T(ln.name),{px:13,wgt:800,anchor:'middle'});
    if(ln.badge){
      const bt=T(ln.badge), bw=estW(bt,10)+16;
      s+=`<rect x="${cx-bw/2}" y="22" width="${bw}" height="16" rx="4" fill="${ln.c||'#6b7280'}"/>`;
      s+=text(cx,34,bt,{px:10,wgt:700,c:'#fff',anchor:'middle'});
    }
    if(ln.models){
      wrapText(T(ln.models),10,CW-8).slice(0,2).forEach((ln2,k)=>{
        s+=text(cx,50+k*12,ln2,{px:10,c:MUT,anchor:'middle'});
      });
    }
  });

  /* cells (items flow bottom-up) */
  const drawCell=(cell,x,w,yBot)=>{
    let iy=yBot;
    for(const it of cell.flow){
      const h=itemH(it,w); iy-=h;
      s+=drawItem(it,x,iy,w);
      iy-=ITEM_GAP;
    }
  };
  for(const bl of bandLay)for(const sl of bl.segs){
    if(sl.seg.type==='shared'){
      const cell=cfg.shared[sl.seg.key];
      if(cell) drawCell(cell,areaCx-SW/2,SW,sl.y+sl.h);
    }else{
      cfg.lanes.forEach((_,i)=>{
        const cell=(cfg.cells[i]||{})[sl.seg.key];
        if(cell) drawCell(cell,laneX(i),CW,sl.y+sl.h);
      });
    }
  }

  /* connectors, bottom→top */
  const seq=[];
  [...bandLay].reverse().forEach(bl=>[...bl.segs].reverse().forEach(sl=>seq.push(sl)));
  for(let k=0;k<seq.length-1;k++){
    const lo=seq[k], up=seq[k+1];
    const y1=lo.y, y2=up.y+up.h;   // from top of lower seg → bottom of upper seg (upward)
    const loS=lo.seg.type==='shared', upS=up.seg.type==='shared';
    const link=(x1,x2)=>{
      if(Math.abs(x1-x2)<1) s+=`<line x1="${x1}" y1="${y1}" x2="${x2}" y2="${y2}" stroke="${ARR}" stroke-width="1.6" marker-end="url(#ah)"/>`;
      else{const my=(y1+y2)/2;s+=`<path d="M ${x1} ${y1} C ${x1} ${my}, ${x2} ${my}, ${x2} ${y2}" fill="none" stroke="${ARR}" stroke-width="1.6" marker-end="url(#ah)"/>`;}
    };
    for(let i=0;i<n;i++){
      const hasLo=loS||((cfg.cells[i]||{})[lo.seg.key]), hasUp=upS||((cfg.cells[i]||{})[up.seg.key]);
      if(!hasLo||!hasUp) continue;
      const xl=loS?areaCx+(laneCx(i)-areaCx)*0.5:laneCx(i);
      const xu=upS?areaCx+(laneCx(i)-areaCx)*0.5:laneCx(i);
      link(xl,xu);
    }
  }

  s+='</svg>';
  mount.innerHTML=s;
}

/* ---------- map ---------- */
const MAP_FAM={'Whisper':'a','Fun-ASR':'a','Qwen3-ASR':'a','MOSS-Local':'d','MOSS delay':'d','Higgs / ZONOS2':'d','Qwen3-TTS':'d','Qwen3-Omni':'d','Fish S2-Pro':'d','Voxtral':'h','dots.tts':'c','Ming-omni-TTS':'c','Ming-flash-omni':'c'};
const MAP_FC={a:'#98a2b3',d:'#D97B29',c:'#3D9970',h:'#7A5C9E'};
function renderMap(mount){
  const W=680,H=470,PL=46,PR=16,PT=20,PB=54;
  const sx=v=>PL+v/3.4*(W-PL-PR), sy=v=>H-PB-v/1.05*(H-PB-PT);
  let s=`<svg width="${W}" height="${H}" viewBox="0 0 ${W} ${H}" xmlns="http://www.w3.org/2000/svg">`;
  for(const t of MAP_TICKS){
    s+=`<line x1="${sx(t.x)}" y1="${PT}" x2="${sx(t.x)}" y2="${H-PB}" stroke="#e4e8ef" stroke-dasharray="4 4"/>`;
    s+=text(sx(t.x),H-PB+16,T(t.t),{px:10.5,c:MUT,anchor:'middle'});
  }
  s+=`<line x1="${PL}" y1="${H-PB}" x2="${W-PR}" y2="${H-PB}" stroke="#c9d0da"/>`;
  s+=`<line x1="${PL}" y1="${PT}" x2="${PL}" y2="${H-PB}" stroke="#c9d0da"/>`;
  s+=text((PL+W-PR)/2,H-12,T(MAP_XLAB),{px:12,wgt:700,c:INK,anchor:'middle'});
  s+=`<text x="14" y="${(PT+H-PB)/2}" font-size="12" font-weight="700" fill="${INK}" text-anchor="middle" transform="rotate(-90 14 ${(PT+H-PB)/2})">${esc(T(MAP_YLAB))}</text>`;
  s+=text(sx(0.55),sy(1.0),T(['ASR: no Talker','ASR：无 Talker']),{px:10,c:'#98a2b3'});
  for(const p of MAP_POINTS){
    const c=MAP_FC[MAP_FAM[p.name]||'a'];
    s+=`<circle cx="${sx(p.x)}" cy="${sy(p.y)}" r="6" fill="${c}" opacity="0.9"/>`;
    s+=text(sx(p.x)+9,sy(p.y)+4,p.name,{px:11,wgt:600,c:'#39404d'});
  }
  s+='</svg>';
  mount.innerHTML=s;
}

/* ---------- table ---------- */
function renderTable(mount){
  let s='<thead><tr>'+CMP_HEAD.map(h=>`<th>${esc(h)}</th>`).join('')+'</tr></thead><tbody>';
  for(const r of CMP_ROWS) s+='<tr>'+r.map(c=>`<td>${esc(c)}</td>`).join('')+'</tr>';
  mount.innerHTML=s+'</tbody>';
}

/* ---------- page ---------- */
function renderAll(){
  document.querySelectorAll('[data-t]').forEach(el=>{el.innerHTML=T(I18N[el.dataset.t]);});
  document.getElementById('legend').innerHTML=[
    ['sw key','lg_key'],['sw common','lg_common'],['sw pill','lg_pill'],['sw chip','lg_chip'],
  ].map(([cls,k])=>`<span class="item"><span class="sw ${cls}"></span>${T(I18N[k])}</span>`).join('');

  renderFigure(REF_FIG,document.getElementById('fig-reference'));
  renderFigure(FAMILIES_FIG,document.getElementById('fig-families'));

  const dc=document.getElementById('discrete-figs');
  dc.innerHTML=DISCRETE_FIGS.map((d,i)=>`
    <h3><span style="color:var(--mut)">3.${i+1}</span> ${T(d.claim)}</h3>
    <p class="lead">${T(d.sub)}</p>
    <div class="card scroll-x"><div id="dfig-${i}"></div></div>
    <div class="takeaway">${T(d.take)}</div>`).join('');
  DISCRETE_FIGS.forEach((d,i)=>renderFigure(d.fig,document.getElementById('dfig-'+i)));

  renderFigure(CONT_FIG,document.getElementById('fig-cont'));
  renderFigure(OMNI_FIG,document.getElementById('fig-omni'));
  renderFigure(ASR_FIG,document.getElementById('fig-asr'));
  renderMap(document.getElementById('fig-map'));
  renderTable(document.getElementById('cmp-table'));
}
renderAll();
</script>
